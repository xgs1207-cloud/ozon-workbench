# Ozon 上品自动化工作台 —— 环境变量模板
#
# 复制到 /etc/ozon-workbench.env，填好值后：
#   sudo chown root:root /etc/ozon-workbench.env
#   sudo chmod 600 /etc/ozon-workbench.env      # 只有 root 能读
#   sudo systemctl restart ozon-workbench-api
#
# ⚠️ 这个文件是**唯一**放密钥的地方。config/shops.json 里只写「环境变量名」，
#    不要把密钥写进注册表（写入时也会被拦下）。

# ---- Ozon 店铺凭据（变量名必须与 config/shops.json 里的 *_env 一致）----
OZON_DEFAULT_CLIENT_ID=
OZON_DEFAULT_API_KEY=
# 多店铺就再加：
# OZON_SHOP_A_CLIENT_ID=
# OZON_SHOP_A_API_KEY=

# ---- 火山方舟（豆包）：文本 + 生图共用一个 Key ----
ARK_API_KEY=
ARK_TEXT_MODEL=ep-2026xxxx            # 方舟控制台的文本接入点 ID
ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
ARK_IMAGE_SIZE=1152x1536

# ---- 可选：模型层与服务 ----
# MODEL_PROVIDER=ark
# MODEL_TIMEOUT=90
# MODEL_MAX_ATTEMPTS=2
# APP_MODE=production                  # 只有 production 才允许真实提交 Ozon
# IMAGE_GENERATOR=doubao

# ---- 图片存储：腾讯云 COS（对象存储在你的服务器/腾讯云）----
# Ozon 只能抓 https；COS 自带 https 域名，最省事
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=                      # 形如 my-bucket-1250000000
COS_REGION=                      # 形如 ap-hongkong / ap-guangzhou
COS_KEY_PREFIX=ozon-images       # 对象键前缀（目录）
# COS_TOKEN=                     # 用临时密钥（STS）时填
# COS_PUBLIC_BASE_URL=           # 用 CDN / 自定义域名时填（如 https://cdn.du4s.com）

# ---- 自建 nginx 静态目录方案（二选一，不用 COS 时才需要）----
OZON_IMAGE_ROOT=/var/www/ozon-images
OZON_IMAGE_BASE_URL=
