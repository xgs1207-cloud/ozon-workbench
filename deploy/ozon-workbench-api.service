[Unit]
Description=Ozon 上品自动化工作台 API（FastAPI/uvicorn）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ozon
Group=ozon
WorkingDirectory=/opt/ozon-workbench
# 凭据只放在这里（chmod 600，root 拥有）；注册表里只写环境变量名
EnvironmentFile=-/etc/ozon-workbench.env
ExecStart=/opt/ozon-workbench/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
# 收紧权限：只允许写工作目录与图片目录
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# 路径前加 "-"：目录不存在时**不要**让整个 unit 起不来
# （踩过：/var/www/ozon-images 未创建时服务以 226/NAMESPACE 崩溃重启）
ReadWritePaths=-/opt/ozon-workbench
ReadWritePaths=-/var/www/ozon-images

[Install]
WantedBy=multi-user.target
